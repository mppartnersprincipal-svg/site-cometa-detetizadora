{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hello-world",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hello-world/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(img|video|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
